manifest {
    name = 'RiceFlow'
    version = '0.1.0'
    nextflowVersion = '25.10.2'
}
params {
    config_json = null
    policy = null
    outdir = 'reports/unlaunched'
    inject_failure = false
    image = null
}
process {
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    maxForks = 1
    time = '20 min'
    errorStrategy = 'terminate'
    maxRetries = 0
}
executor {
    cpus = 4
    memory = '8 GB'
    queueSize = 2
}
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,attempt'
profiles {
    'native' { docker.enabled = false }
    docker {
        docker.enabled = true
        process.container = params.image ?: 'riceflow:0.1.0'
        docker.runOptions = '--platform linux/amd64'
    }
}
