// Prepared only. Requires approved costs, provisioned outputs and immutable ECR digest.
plugins { id 'nf-amazon@3.4.1' }

workDir = "${System.getenv('RICEFLOW_S3')}/work"
process {
    executor = 'awsbatch'
    queue = System.getenv('RICEFLOW_QUEUE')
    container = System.getenv('RICEFLOW_IMAGE')
    cpus = 1
    memory = '2 GB'
    maxForks = 1
    time = '15 min'
    maxRetries = 0
    errorStrategy = 'terminate'
}
executor.queueSize = 1
aws {
    region = System.getenv('AWS_REGION') ?: System.getenv('AWS_DEFAULT_REGION')
    batch {
        // AWS CLI is already installed inside the tested task image.
        jobRole = System.getenv('RICEFLOW_TASK_ROLE')
        logsGroup = System.getenv('RICEFLOW_LOG_GROUP')
        maxParallelTransfers = 2
        maxTransferAttempts = 2
    }
}
